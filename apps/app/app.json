{
  "expo": {
    "name": "Wish Me",
    "slug": "wishme",
    "scheme": "wishme",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "fr.wishme.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.wishme.app",
      "adaptiveIcon": {
        "backgroundColor": "#F3F2F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-localization", "expo-sqlite", "expo-sharing"],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/58a38fec-eb93-424b-a6da-90e6cc355514"
    },
    "extra": {
      "eas": {
        "projectId": "58a38fec-eb93-424b-a6da-90e6cc355514"
      }
    }
  }
}
